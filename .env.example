GOOGLE_API_KEY=replace-with-gemini-api-key
# Example only; replace with your Supabase PostgreSQL connection string.
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require
ALPHA_VANTAGE_API_KEY=

# Optional pool limits; defaults are 2 authentication + 2 checkpoint connections.
POSTGRES_AUTH_POOL_MAX_SIZE=2
POSTGRES_CHECKPOINT_POOL_MAX_SIZE=2

LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
